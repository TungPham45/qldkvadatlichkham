{
  "info": {
    "name": "Đặt lịch khám - bệnh nhân",
    "description": "Chạy qua API gateway http://localhost:3000. Tài khoản seed: bn1, bs1, admin / mật khẩu 123456. Thư mục chạy theo thứ tự. workDate mặc định là hôm nay + 45 ngày; xóa biến workDate nếu ca sáng ngày đó đã kín slot.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:3000" },
    { "key": "patientToken", "value": "" },
    { "key": "doctorToken", "value": "" },
    { "key": "managerToken", "value": "" },
    { "key": "patient2Token", "value": "" },
    { "key": "workDate", "value": "" },
    { "key": "doctorId", "value": "1" },
    { "key": "scheduleId", "value": "" },
    { "key": "slotStart", "value": "07:30" },
    { "key": "appointmentId", "value": "" },
    { "key": "p2user", "value": "" },
    { "key": "p2phone", "value": "" },
    { "key": "p2email", "value": "" },
    { "key": "longReason", "value": "" }
  ],
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "if (!pm.collectionVariables.get('workDate')) {",
          "  const parts = new Intl.DateTimeFormat('en-CA', { timeZone: 'Asia/Ho_Chi_Minh', year: 'numeric', month: '2-digit', day: '2-digit' }).formatToParts(new Date(Date.now() + 45 * 86400000));",
          "  const pick = (type) => parts.find((part) => part.type === type).value;",
          "  pm.collectionVariables.set('workDate', pick('year') + '-' + pick('month') + '-' + pick('day'));",
          "}"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "00. Đăng nhập",
      "item": [
        {
          "name": "Bệnh nhân bn1",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('200', () => pm.response.to.have.status(200));",
            "const body = pm.response.json();",
            "pm.test('role PATIENT', () => pm.expect(body.user.role).to.eql('PATIENT'));",
            "pm.collectionVariables.set('patientToken', body.accessToken);"
          ] } }],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"username\": \"bn1\",\n  \"password\": \"123456\"\n}" },
            "url": "{{baseUrl}}/api/auth/login"
          }
        },
        {
          "name": "Bác sĩ bs1",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('200', () => pm.response.to.have.status(200));",
            "const body = pm.response.json();",
            "pm.test('role DOCTOR', () => pm.expect(body.user.role).to.eql('DOCTOR'));",
            "pm.collectionVariables.set('doctorToken', body.accessToken);"
          ] } }],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"username\": \"bs1\",\n  \"password\": \"123456\"\n}" },
            "url": "{{baseUrl}}/api/auth/login"
          }
        },
        {
          "name": "Quản lý admin",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('200', () => pm.response.to.have.status(200));",
            "const body = pm.response.json();",
            "pm.test('role MANAGER', () => pm.expect(body.user.role).to.eql('MANAGER'));",
            "pm.collectionVariables.set('managerToken', body.accessToken);"
          ] } }],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"username\": \"admin\",\n  \"password\": \"123456\"\n}" },
            "url": "{{baseUrl}}/api/auth/login"
          }
        }
      ]
    },
