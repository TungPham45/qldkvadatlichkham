    {
      "name": "04. Đặt lịch thành công",
      "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{patientToken}}", "type": "string" }] },
      "item": [
        {
          "name": "Xem giờ trống sau khi duyệt",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('200', () => pm.response.to.have.status(200));",
            "const body = pm.response.json();",
            "const slot = body.slots.find((item) => item.available);",
            "pm.test('có ít nhất một slot trống', () => pm.expect(slot).to.be.an('object'));",
            "pm.test('slot có start, end, available', () => {",
            "  pm.expect(slot).to.have.property('start');",
            "  pm.expect(slot).to.have.property('end');",
            "  pm.expect(slot.available).to.eql(true);",
            "});",
            "pm.collectionVariables.set('slotStart', slot.start.slice(0, 5));",
            "pm.collectionVariables.set('doctorId', String(body.doctorId));"
          ] } }],
          "request": { "method": "GET", "url": "{{baseUrl}}/api/appointments/availability?doctorId={{doctorId}}&date={{workDate}}" }
        },
        {
          "name": "Đặt slot trống",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('201', () => pm.response.to.have.status(201));",
            "const body = pm.response.json();",
            "pm.test('Chờ xác nhận', () => pm.expect(body.trangThai).to.eql('Cho xac nhan'));",
            "pm.test('Nguồn Online', () => pm.expect(body.nguonDatLich).to.eql('Online'));",
            "pm.test('Đúng bác sĩ và ngày', () => {",
            "  pm.expect(body.bacSiId).to.eql(Number(pm.collectionVariables.get('doctorId')));",
            "  pm.expect(String(body.ngayHen).slice(0, 10)).to.eql(pm.collectionVariables.get('workDate'));",
            "});",
            "pm.test('Giờ được chuẩn hóa HH:mm:ss', () => pm.expect(body.gioBatDau).to.eql(pm.collectionVariables.get('slotStart') + ':00'));",
            "pm.test('Có giờ kết thúc', () => pm.expect(body.gioKetThuc).to.be.a('string'));",
            "pm.collectionVariables.set('appointmentId', String(body.id));"
          ] } }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"bacSiId\": {{doctorId}},\n  \"ngayHen\": \"{{workDate}}\",\n  \"gioHen\": \"{{slotStart}}\",\n  \"lyDoKham\": \"Đau đầu nhẹ từ sáng\"\n}" },
            "url": "{{baseUrl}}/api/appointments"
          }
        },
        {
          "name": "Slot vừa đặt không còn trống",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('200', () => pm.response.to.have.status(200));",
            "const start = pm.collectionVariables.get('slotStart') + ':00';",
            "const slot = pm.response.json().slots.find((item) => item.start === start);",
            "pm.test('available = false', () => pm.expect(slot && slot.available).to.eql(false));"
          ] } }],
          "request": { "method": "GET", "url": "{{baseUrl}}/api/appointments/availability?doctorId={{doctorId}}&date={{workDate}}" }
        },
        {
          "name": "Đặt lại đúng slot",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('409', () => pm.response.to.have.status(409));",
            "pm.test('APPOINTMENT_SLOT_ALREADY_BOOKED', () => pm.expect(pm.response.json().code).to.eql('APPOINTMENT_SLOT_ALREADY_BOOKED'));"
          ] } }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"bacSiId\": {{doctorId}},\n  \"ngayHen\": \"{{workDate}}\",\n  \"gioHen\": \"{{slotStart}}:00\",\n  \"lyDoKham\": \"Đặt lại cùng giờ\"\n}" },
            "url": "{{baseUrl}}/api/appointments"
          }
        },
        {
          "name": "Lịch của tôi có lịch vừa đặt",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('200', () => pm.response.to.have.status(200));",
            "const body = pm.response.json();",
            "pm.test('có total và items', () => { pm.expect(body.total).to.be.a('number'); pm.expect(body.items).to.be.an('array'); });",
            "pm.test('chứa appointmentId', () => pm.expect(body.items.some((item) => String(item.id) === pm.collectionVariables.get('appointmentId'))).to.eql(true));"
          ] } }],
          "request": { "method": "GET", "url": "{{baseUrl}}/api/appointments/me?page=1&pageSize=8" }
        },
        {
          "name": "Lịch sắp tới chứa lịch vừa đặt",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('200', () => pm.response.to.have.status(200));",
            "pm.test('upcoming chứa lịch mới', () => pm.expect(pm.response.json().items.some((item) => String(item.id) === pm.collectionVariables.get('appointmentId'))).to.eql(true));"
          ] } }],
          "request": { "method": "GET", "url": "{{baseUrl}}/api/appointments/me?upcoming=true&pageSize=20" }
        }
      ]
    },
    {
      "name": "05. Bệnh nhân khác cùng slot",
      "item": [
        {
          "name": "Đăng ký bệnh nhân thứ hai",
          "event": [
            { "listen": "prerequest", "script": { "type": "text/javascript", "exec": [
              "const suffix = Date.now().toString().slice(-9);",
              "pm.collectionVariables.set('p2user', 'bn' + suffix);",
              "pm.collectionVariables.set('p2phone', '0' + suffix);",
              "pm.collectionVariables.set('p2email', 'bn' + suffix + '@example.com');"
            ] } },
            { "listen": "test", "script": { "type": "text/javascript", "exec": [
              "pm.test('201', () => pm.response.to.have.status(201));",
              "pm.collectionVariables.set('patient2Token', pm.response.json().accessToken);"
            ] } }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"hoTen\": \"Bệnh nhân kiểm thử\",\n  \"ngaySinh\": \"1995-01-01\",\n  \"gioiTinh\": \"Nam\",\n  \"soDienThoai\": \"{{p2phone}}\",\n  \"email\": \"{{p2email}}\",\n  \"diaChi\": \"Hà Nội\",\n  \"username\": \"{{p2user}}\",\n  \"password\": \"123456\",\n  \"confirmPassword\": \"123456\"\n}" },
            "url": "{{baseUrl}}/api/auth/register"
          }
        },
        {
          "name": "Bệnh nhân thứ hai đặt cùng slot",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('409', () => pm.response.to.have.status(409));",
            "pm.test('APPOINTMENT_SLOT_ALREADY_BOOKED', () => pm.expect(pm.response.json().code).to.eql('APPOINTMENT_SLOT_ALREADY_BOOKED'));"
          ] } }],
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{patient2Token}}", "type": "string" }] },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"bacSiId\": {{doctorId}},\n  \"ngayHen\": \"{{workDate}}\",\n  \"gioHen\": \"{{slotStart}}\",\n  \"lyDoKham\": \"Bệnh nhân khác cùng giờ\"\n}" },
            "url": "{{baseUrl}}/api/appointments"
          }
        }
      ]
    }
  ]
}
