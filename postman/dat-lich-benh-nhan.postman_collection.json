          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('200', () => pm.response.to.have.status(200));",
            "const item = pm.response.json().items.find((row) => String(row.date).slice(0, 10) === pm.collectionVariables.get('workDate') && row.shift === 'SANG');",
            "pm.test('có ca sáng', () => pm.expect(item).to.be.an('object'));",
            "pm.collectionVariables.set('scheduleId', String(item.id));",
            "pm.collectionVariables.set('doctorId', String(item.doctorId));"
